# Required on Vercel (Project → Settings → Environment Variables)
# Copy from Supabase → Project Settings → API → "anon" "public" key
# (long string starting with eyJ...  OR the publishable key shown in the dashboard)
VITE_SUPABASE_ANON_KEY=

# Optional (code already defaults to your project URL)
# VITE_SUPABASE_URL=https://hdsoxtlruzuadsqkapls.supabase.co

# After changing env vars on Vercel you MUST Redeploy for them to take effect.
